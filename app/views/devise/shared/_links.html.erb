<%# 補助リンク %>
<div class="d-flex flex-column gap-1 mt-3">

  <% if controller_name != 'sessions' %>
    <%= link_to "ログイン", new_session_path(resource_name),
          class: "btn btn-outline-primary btn-sm shadow-sm px-4 mx-auto d-block" %>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "新規登録", new_registration_path(resource_name),
          class: "btn btn-outline-success btn-sm shadow-sm px-4 mx-auto d-block" %>
  <% end %>

  <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "パスワードを忘れましたか？", new_password_path(resource_name),
          class: "btn btn-outline-secondary btn-sm shadow-sm px-4 mx-auto d-block" %>
  <% end %>

  <% if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "確認メールが届いていませんか？", new_confirmation_path(resource_name),
          class: "btn btn-outline-warning btn-sm shadow-sm px-4 mx-auto d-block" %>
  <% end %>

  <% if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to "アカウントロック解除メールを再送", new_unlock_path(resource_name),
          class: "btn btn-outline-danger btn-sm shadow-sm px-4 mx-auto d-block" %>
  <% end %>

  <% if devise_mapping.omniauthable? %>
    <% resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "#{OmniAuth::Utils.camelize(provider)}でログイン",
            omniauth_authorize_path(resource_name, provider),
            data: { turbo: false },
            class: "btn btn-outline-dark btn-sm shadow-sm px-4 mx-auto d-block" %>
    <% end %>
  <% end %>

</div>

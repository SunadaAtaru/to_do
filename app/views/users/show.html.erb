<div class="container mt-5">
  <div class="card shadow-sm mx-auto" style="max-width: 800px;">
    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-md-3 text-center mb-3 mb-md-0">
          <%= avatar_for(@user) %>
        </div>

        <div class="col-md-9">
          <h2 class="text-center text-md-start"><%= @user.username %> さんのマイページ</h2>
          <p class="mb-1"><strong>メールアドレス:</strong> <%= @user.email %></p>
          <p class="mb-1"><strong>登録日:</strong> <%= l(@user.created_at, format: :long) %></p>
          <p class="mb-3"><strong>タスク総数:</strong> <%= @user.tasks.count %> 件</p>
          <div class="text-center text-md-start">
            <%= link_to 'プロフィールを編集', edit_user_registration_path, class: "btn btn-outline-primary btn-sm shadow-sm" %>
          </div>
        </div>
      </div>

      <hr>

      <h4 class="mt-4 text-center text-md-start">最近作成したタスク</h4>

      <% if @user.tasks.any? %>
        <ul class="list-group mt-2">
          <% @user.tasks.order(created_at: :desc).limit(5).each do |task| %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <%= task.title %>
              <span class="badge bg-primary rounded-pill"><%= l(task.created_at, format: :short) %></span>
            </li>
          <% end %>
        </ul>
        <div class="text-center text-md-start">
          <%= link_to 'タスク一覧を見る', user_tasks_path, class: "btn btn-outline-primary mt-2 shadow-sm" %>
        </div>
      <% else %>
        <p class="text-muted mt-2 text-center">まだタスクは登録されていません。</p>
        <div class="text-center">
          <%= link_to 'を作成する', new_task_path, class: "btn btn-outline-primary mt-2 shadow-sm" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
